# Copy this file to `.env` and fill it in. `.env` is gitignored; this example
# is not. Never put real credentials in this file.
#
# Nothing secret is ever passed as a command-line flag: arguments land in shell
# history and are readable by other processes on the machine.

# ---------------------------------------------------------------------------
# Twilio
# Console > Account Info. The auth token is a live credential for your whole
# Twilio account - treat it like a password.
# ---------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=

# The number messages are sent from. Prefix WhatsApp numbers with `whatsapp:`.
TWILIO_NUMBER=whatsapp:+14155238886

# Default Studio flow, from the flow's URL in the Console. Starts with FW.
# Can be overridden per command with --flow-id.
TWILIO_FLOW_ID=FWxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---------------------------------------------------------------------------
# Twilio API key (only needed for the Twilio MCP server, not for `rtt` itself)
#
# Console > Account > API keys & tokens > Create API key (type: Standard).
# The secret is displayed exactly once at creation - copy it before closing.
#
# Prefer these over the auth token above wherever possible: an API key can be
# revoked on its own, without rotating the credential for your whole account.
#
# After filling these in, run `just mcp-setup` to generate the Claude Code
# settings that the MCP server reads.
# ---------------------------------------------------------------------------
TWILIO_API_KEY=SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_SECRET=

# ---------------------------------------------------------------------------
# Encryption
#
# Generate a keypair with `just keygen`. The PUBLIC key goes into the Twilio
# Function Service as ENCRYPTION_PUBLIC_KEY; it stays out of this file because
# this machine never needs it. The PRIVATE key below is the only thing that can
# read collected responses back.
#
# Lose the private key and the data is unrecoverable - exactly as with a
# SurveyCTO private key. Back it up somewhere access-controlled.
#
# Either paste the key here, or leave this blank and point at the file that
# `just keygen` wrote.
# ---------------------------------------------------------------------------
ENCRYPTION_PRIVATE_KEY=
ENCRYPTION_PRIVATE_KEY_FILE=rtt_private_key.txt

# Only needed to read data collected before version 2.0, which used a single
# shared secret. Leave blank otherwise.
LEGACY_SECRET_KEY=

# ---------------------------------------------------------------------------
# MotherDuck (optional)
#
# Decrypted survey data is Confidential under IPA's data classification. Point
# this at a database approved and access-controlled for that classification.
# ---------------------------------------------------------------------------
MOTHERDUCK_TOKEN=
MOTHERDUCK_DATABASE=
