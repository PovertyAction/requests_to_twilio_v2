# Copy this file to `.env` and fill it in. `.env` is gitignored; this example
# is not. Never put real credentials in this file.
#
# Nothing secret is ever passed as a command-line flag: arguments land in shell
# history and are readable by other processes on the machine.

# ---------------------------------------------------------------------------
# Twilio
# Console > Account Info. The auth token is a live credential for your whole
# Twilio account - treat it like a password.
# ---------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=

# The number messages are sent from. Prefix WhatsApp numbers with `whatsapp:`.
TWILIO_NUMBER=whatsapp:+14155238886

# Default Studio flow, from the flow's URL in the Console. Starts with FW.
# Can be overridden per command with --flow-id.
TWILIO_FLOW_ID=FWxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---------------------------------------------------------------------------
# Twilio API key (only needed for the Twilio MCP server, not for `rtt` itself)
#
# Console > Account > API keys & tokens > Create API key (type: Standard).
# The secret is displayed exactly once at creation - copy it before closing.
#
# Prefer these over the auth token above wherever possible: an API key can be
# revoked on its own, without rotating the credential for your whole account.
#
# After filling these in, run `just mcp-setup` to generate the Claude Code
# settings that the MCP server reads.
# ---------------------------------------------------------------------------
TWILIO_API_KEY=SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_SECRET=

# ---------------------------------------------------------------------------
# Encryption
#
# Generate a keypair with `just keygen`. The PUBLIC key goes into the Twilio
# Function Service as ENCRYPTION_PUBLIC_KEY; it stays out of this file because
# this machine never needs it. The PRIVATE key below is the only thing that can
# read collected responses back.
#
# Lose the private key and the data is unrecoverable - exactly as with a
# SurveyCTO private key. Back it up somewhere access-controlled.
#
# Either paste the key here, or leave this blank and point at the file that
# `just keygen` wrote.
# ---------------------------------------------------------------------------
ENCRYPTION_PRIVATE_KEY=
ENCRYPTION_PRIVATE_KEY_FILE=rtt_private_key.txt

# Only needed to read data collected before version 2.0, which used a single
# shared secret. Leave blank otherwise.
LEGACY_SECRET_KEY=

# ---------------------------------------------------------------------------
# MotherDuck (optional)
#
# Decrypted survey data is Confidential under IPA's data classification. Point
# this at a database approved and access-controlled for that classification.
# ---------------------------------------------------------------------------
MOTHERDUCK_TOKEN=
MOTHERDUCK_DATABASE=

# Only needed by the Twilio Function that publishes straight to MotherDuck.
# It reaches the warehouse over the Postgres wire protocol, which needs a
# host; the Python side connects via md: and does not.
MOTHERDUCK_HOST=pg.us-east-1-aws.motherduck.com

# Fully qualified: database.schema.table. Create it first - the publish Function
# never creates a table, because guessing a schema for survey data produces
# wrong types and a silent CREATE would hide a typo here. `just flow-schema`
# prints the right DDL from the flow itself.
MOTHERDUCK_TABLE=your_database.main.your_round

# ---------------------------------------------------------------------------
# Google Sheets (optional)
#
# The other publish target, and the one that needs least to get started: a
# spreadsheet anybody on the team can open, rather than a warehouse and a query
# language. Build a flow against it with:
#
#     just build-demo-flow --publish-target gsheets
#
# Setting these up:
#
#   1. Google Cloud console > enable the Google Sheets API on a project.
#   2. IAM & Admin > Service Accounts > create one. No project roles are needed
#      - access to the sheet is granted on the sheet, not through IAM.
#   3. Its Keys tab > Add key > Create new key > JSON. This downloads once.
#   4. Share the target sheet with the service account's address (it ends in
#      .iam.gserviceaccount.com) as an Editor. A service account is a principal
#      in its own right; creating it grants it nothing.
#   5. Put a header row in row 1 of the sheet. Generate it from the instrument
#      rather than typing it:
#
#          just flow-header flows/data_use_demo_en.json
#
#      A parameter with no matching header is dropped - the Function logs it,
#      but the row is still written and still looks complete.
#
# THE JSON KEY IS A LIVE CREDENTIAL. Anyone holding it can act as that service
# account. Keep the file outside this repository, or at a gitignored path
# inside it, and never paste its contents into a chat, an issue or this file.
# An earlier version of this project published one to a public GitHub repo,
# where it stayed valid for roughly 19 months.
# ---------------------------------------------------------------------------

# Path to the downloaded service-account JSON. Absolute, or relative to the
# repository root. The private key inside it is ~1,700 bytes, which is over
# Twilio's 450-byte cap on an environment variable, so `just deploy-functions`
# splits it across GOOGLE_PRIVATE_KEY_1, _2, ... for you.
GOOGLE_SERVICE_ACCOUNT_FILE=

# The spreadsheet's ID, the long string between /d/ and /edit in its URL.
GOOGLE_SHEET_ID=
