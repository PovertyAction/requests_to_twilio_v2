{
  "mcpServers": {
    "twilio-docs": {
      "type": "http",
      "url": "https://mcp.twilio.com/docs"
    },
    "twilio": {
      "command": "npx",
      "args": [
        "-y",
        "@twilio-alpha/mcp@0.7.0",
        "${TWILIO_ACCOUNT_SID}/${TWILIO_API_KEY}:${TWILIO_API_SECRET}",
        "--services",
        "twilio_studio_v2,twilio_content_v1,twilio_content_v2"
      ]
    }
  }
}
