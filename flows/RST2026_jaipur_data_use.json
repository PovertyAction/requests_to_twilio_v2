{
  "description": "RST Jaipur 2026 - data use survey (ARM1/ARM2 experiment)",
  "states": [
    {
      "name": "Trigger",
      "type": "trigger",
      "properties": {
        "offset": {
          "x": 0,
          "y": -1100
        }
      },
      "transitions": [
        {
          "event": "incomingMessage",
          "next": "intro"
        },
        {
          "event": "incomingCall"
        },
        {
          "event": "incomingConversationMessage"
        },
        {
          "event": "incomingRequest"
        },
        {
          "event": "incomingParent"
        }
      ]
    },
    {
      "name": "intro",
      "type": "send-message",
      "properties": {
        "offset": {
          "x": 0,
          "y": -950
        },
        "from": "{{flow.channel.address}}",
        "body": "Hi {{flow.data.name}}, welcome to the Research Staff Training 2026 in Jaipur.\n\nYou are about to take part in a real WhatsApp survey - and you are also part of the example.\n\nIt takes about 3 minutes. Your answers are confidential and will only be used to illustrate WhatsApp data collection during the session."
      },
      "transitions": [
        {
          "event": "sent",
          "next": "consent"
        },
        {
          "event": "failed",
          "next": "consent"
        }
      ]
    },
    {
      "name": "consent",
      "type": "send-and-wait-for-reply",
      "properties": {
        "offset": {
          "x": 0,
          "y": -820
        },
        "from": "{{flow.channel.address}}",
        "body": "Would you like to take part?\n\nReply *1* for Yes, or *2* for No.\n\nTaking part is voluntary and you can stop at any time by not replying.",
        "timeout": "3600"
      },
      "transitions": [
        {
          "event": "incomingMessage",
          "next": "split_consent"
        },
        {
          "event": "timeout",
          "next": "mark_no_reply"
        },
        {
          "event": "deliveryFailure",
          "next": "mark_delivery_failed"
        }
      ]
    },
    {
      "name": "split_consent",
      "type": "split-based-on",
      "properties": {
        "offset": {
          "x": 0,
          "y": -700
        },
        "input": "{{widgets.consent.inbound.Body}}"
      },
      "transitions": [
        {
          "event": "noMatch",
          "next": "record_declined"
        },
        {
          "event": "match",
          "next": "record_consent",
          "conditions": [
            {
              "friendly_name": "is 1",
              "arguments": [
                "{{widgets.consent.inbound.Body}}"
              ],
              "type": "equal_to",
              "value": "1"
            }
          ]
        },
        {
          "event": "match",
          "next": "record_declined",
          "conditions": [
            {
              "friendly_name": "is 2",
              "arguments": [
                "{{widgets.consent.inbound.Body}}"
              ],
              "type": "equal_to",
              "value": "2"
            }
          ]
        }
      ]
    },
    {
      "name": "record_consent",
      "type": "set-variables",
      "properties": {
        "offset": {
          "x": 0,
          "y": -580
        },
        "variables": [
          {
            "key": "set_consent",
            "value": "yes"
          }
        ]
      },
      "transitions": [
        {
          "event": "next",
          "next": "split_arm"
        }
      ]
    },
    {
      "name": "record_declined",
      "type": "set-variables",
      "properties": {
        "offset": {
          "x": 400,
          "y": -580
        },
        "variables": [
          {
            "key": "set_consent",
            "value": "no"
          },
          {
            "key": "outcome",
            "value": "declined"
          }
        ]
      },
      "transitions": [
        {
          "event": "next",
          "next": "finish"
        }
      ]
    },
    {
      "name": "split_arm",
      "type": "split-based-on",
      "properties": {
        "offset": {
          "x": 0,
          "y": -460
        },
        "input": "{{flow.data.arm}}"
      },
      "transitions": [
        {
          "event": "noMatch",
          "next": "ARM1_P1"
        },
        {
          "event": "match",
          "next": "ARM1_P1",
          "conditions": [
            {
              "friendly_name": "is 1",
              "arguments": [
                "{{flow.data.arm}}"
              ],
              "type": "equal_to",
              "value": "1"
            }
          ]
        },
        {
          "event": "match",
          "next": "ARM2_P1",
          "conditions": [
            {
              "friendly_name": "is 2",
              "arguments": [
                "{{flow.data.arm}}"
              ],
              "type": "equal_to",
              "value": "2"
            }
          ]
        }
      ]
    },
    {
      "name": "ARM1_P1",
      "type": "send-and-wait-for-reply",
      "properties": {
        "offset": {
          "x": -700,
          "y": -300
        },
        "from": "{{flow.channel.address}}",
        "body": "In the last four (4) weeks, on how many occasions have you drawn on quantitative or qualitative data (for example databases, administrative records, statistical reports, surveys, dashboards) as an input to decisions related to your work?\n\n_Reply with an exact number (e.g. 0, 3, 12)._",
        "timeout": "3600"
      },
      "transitions": [
        {
          "event": "incomingMessage",
          "next": "store_ARM1_P1"
        },
        {
          "event": "timeout",
          "next": "mark_no_reply"
        },
        {
          "event": "deliveryFailure",
          "next": "mark_delivery_failed"
        }
      ]
    },
    {
      "name": "store_ARM1_P1",
      "type": "set-variables",
      "properties": {
        "offset": {
          "x": -700,
          "y": -220
        },
        "variables": [
          {
            "key": "ARM1_P1_status",
            "value": "answered"
          }
        ]
