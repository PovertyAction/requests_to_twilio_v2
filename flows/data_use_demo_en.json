{
  "description": "Data use demo (ARM1/ARM2 experiment) - English, RST Jaipur 2026",
  "states": [
    {
      "name": "Trigger",
      "type": "trigger",
      "properties": {
        "offset": {
          "x": 0,
          "y": -1100
        }
      },
      "transitions": [
        {
          "event": "incomingRequest",
          "next": "intro"
        },
        {
          "event": "incomingMessage",
          "next": "unsolicited_reply"
        },
        {
          "event": "incomingCall"
        },
        {
          "event": "incomingConversationMessage"
        },
        {
          "event": "incomingParent"
        }
      ]
    },
    {
      "name": "unsolicited_reply",
      "type": "send-message",
      "properties": {
        "offset": {
          "x": -600,
          "y": -950
        },
        "from": "{{flow.channel.address}}",
        "body": "👋 Thanks for your message.\n\nThis number only runs a short survey during the session, so there is nothing further needed from you here.\n\nIf you have a question, the IPA team at the training can help."
      },
      "transitions": [
        {
          "event": "sent"
        },
        {
          "event": "failed"
        }
      ]
    },
    {
      "name": "intro",
      "type": "send-and-wait-for-reply",
      "properties": {
        "offset": {
          "x": 0,
          "y": -950
        },
        "from": "{{flow.channel.address}}",
        "message_type": "content_template",
        "content_sid": "HX601b99cf0efe836736ed10baae6188df",
        "timeout": "3600",
        "content_variables": [
          {
            "key": "1",
            "value": "{{flow.data.name | default: 'there'}}"
          }
        ]
      },
      "transitions": [
        {
          "event": "incomingMessage",
          "next": "consent"
        },
        {
          "event": "timeout",
          "next": "mark_never_started"
        },
        {
          "event": "deliveryFailure",
          "next": "mark_delivery_failed"
        }
      ]
    },
    {
      "name": "consent",
      "type": "send-and-wait-for-reply",
      "properties": {
        "offset": {
          "x": 0,
          "y": -820
        },
        "from": "{{flow.channel.address}}",
        "message_type": "content_template",
        "content_sid": "HX35e7503a420fb2131dc5fc8b914f4f1f",
        "timeout": "3600"
      },
      "transitions": [
        {
          "event": "incomingMessage",
          "next": "split_consent"
        },
        {
          "event": "timeout",
          "next": "mark_no_reply"
        },
        {
          "event": "deliveryFailure",
          "next": "mark_delivery_failed"
        }
      ]
    },
    {
      "name": "split_consent",
      "type": "split-based-on",
      "properties": {
        "offset": {
          "x": 0,
          "y": -700
        },
        "input": "{{widgets.consent.inbound.Body}}"
      },
      "transitions": [
        {
          "event": "noMatch",
          "next": "record_declined"
        },
        {
          "event": "match",
          "next": "record_consent",
          "conditions": [
            {
              "friendly_name": "consented",
              "arguments": [
                "{{widgets.consent.inbound.Body}}"
              ],
              "type": "regex",
              "value": "(?:\\s*(?:Yes, I'll take part|1|yes|y)\\s*)"
            }
          ]
        },
        {
          "event": "match",
          "next": "record_declined",
          "conditions": [
            {
              "friendly_name": "declined",
              "arguments": [
                "{{widgets.consent.inbound.Body}}"
              ],
              "type": "regex",
              "value": "(?:\\s*(?:No, thanks|2|no|n)\\s*)"
            }
          ]
        }
      ]
    },
    {
      "name": "record_consent",
      "type": "set-variables",
      "properties": {
        "offset": {
          "x": 0,
          "y": -580
        },
        "variables": [
          {
            "key": "set_consent",
            "value": "yes"
          },
          {
            "key": "set_time_start",
            "value": "{{ 'now' | date: \"%s\" }}"
          }
        ]
      },
      "transitions": [
        {
          "event": "next",
          "next": "split_arm"
        }
      ]
    },
    {
      "name": "record_declined",
      "type": "set-variables",
      "properties": {
        "offset": {
          "x": 400,
          "y": -580
        },
        "variables": [
          {
            "key": "set_consent",
            "value": "no"
          },
          {
            "key": "outcome",
            "value": "declined"
          }
        ]
      },
      "transitions": [
        {
          "event": "next",
          "next": "finish"
        }
      ]
    },
    {
      "name": "split_arm",
      "type": "split-based-on",
      "properties": {
        "offset": {
          "x": 0,
          "y": -460
        },
        "input": "{{flow.data.arm}}"
      },
      "transitions": [
        {
          "event": "noMatch",
          "next": "ARM1_P1"
        },
        {
          "event": "match",
          "next": "ARM1_P1",
          "conditions": [
            {
              "friendly_name": "is 1",
              "arguments": [
                "{{flow.data.arm}}"
              ],
              "type": "equal_to",
              "value": "1"
            }
          ]
        },
        {
          "event": "match",
          "next": "ARM2_P1",
          "conditions": [
            {
              "friendly_name": "is 2",
              "arguments": [
                "{{flow.data.arm}}"
              ],
              "type": "equal_to",
              "value": "2"
            }
          ]
        }
      ]
    },
    {
      "name": "ARM1_P1",
      "type": "send-and-wait-for-reply",
      "properties": {
        "offset": {
          "x": -700,
          "y": -300
        },
        "from": "{{flow.channel.address}}",
        "body": "In the last four (4) weeks, on how many occasions have you drawn on quantitative or qualitative data (for example databases, administrative records, statistical reports, surveys, dashboards) as an input to decisions related to your work?\n\n_Reply with an exact number (e.g. 0, 3, 12)._",
        "timeout": "3600"
      },
      "transitions": [
        {
          "event": "incomingMessage",
          "next": "store_ARM1_P1"
        },
        {
          "event": "timeout",
          "next": "mark_no_reply"
        },
        {
          "event": "deliveryFailure",
          "next": "mark_delivery_failed"
        }
      ]
    },
    {
      "name": "store_ARM1_P1",
      "type": "set-variables",
      "properties": {
        "offset": {
          "x": -700,
          "y": -220
        },
        "variables": [
          {
            "key": "ARM1_P1_status",
            "value": "answered"
          }
        ]
      },
      "transitions": [
        {
          "event": "next",
          "next": "ARM1_P2"
        }
      ]
    },
    {
      "name": "ARM1_P2",
