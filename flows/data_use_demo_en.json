          {
            "key": "ARM2_P1_status",
            "value": "answered"
          },
          {
            "key": "ARM2_P1_code",
            "value": "{% assign reply = widgets.ARM2_P1.inbound.Body | strip | downcase | replace: \".\", \"\" | replace: \")\", \"\" | replace: \"(\", \"\" | strip %}{% case reply %}{% when \"p1_0\" or \"0 times\" or \"1\" %}1{% when \"p1_1_2\" or \"1-2 times\" or \"2\" %}2{% when \"p1_3_5\" or \"3-5 times\" or \"3\" %}3{% when \"p1_6_10\" or \"6-10 times\" or \"4\" %}4{% when \"p1_gt10\" or \"more than 10 times\" or \"5\" %}5{% else %}other{% endcase %}"
