        "offset": {
          "x": -700,
          "y": 40
        },
        "from": "{{flow.channel.address}}",
        "body": "In the last four (4) weeks, in how many projects, tasks or formal processes you took part in was data or empirical evidence used as explicit support for decision making (for example adjusting strategy, allocating resources, redesigning a process)?\n\n_Reply with an exact number (e.g. 0, 3, 12)._",
        "timeout": "3600"
      },
      "transitions": [
        {
          "event": "incomingMessage",
          "next": "store_ARM1_P2"
